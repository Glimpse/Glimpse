  <browser id="deviceShim_Browser_Obigo_Major_Q04C1_Manufacturer_SAMSUNG_seq_2" parentID="deviceShim_Browser_Obigo_Major_Q04C1_Manufacturer_SAMSUNG_seq_1">
    <identification>
      <capability name="_support_deviceIdentity" match="(?i)SAMSUNG(-SAMSUNG|-PLS)?[-\s]?(?'DeviceName'(SGH-|SPH-)?[a-zA-Z0-9]+)([\s\-/;]|$)" />
    </identification>
    <capture>
      <capability name="_support_deviceIdentity" match="(?i)SAMSUNG(-SAMSUNG|-PLS)?[-\s]?(?'DeviceName'(SGH-|SPH-)?[a-zA-Z0-9]+)([\s\-/;]|$)" />
    </capture>
